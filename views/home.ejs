<!DOCTYPE html>
<html lang="en">
    <head>
        <meta charset="UTF-8">
        <meta name="viewport" content="width=device-width, initial-scale=1.0">
        <link rel="stylesheet" href="styles/style1.css" type="text/css">
    </head>

    <body>
        <div class="mainHeader">
            <img class="logo" src="../../assests/images/lockNWhite-01.png">
            <br>
            <% if (user) { %>
                <a href="/logout" class="login">logout</a>
            <% } else { %>
                <a href="/login" class="login">login</a>
            <% } %>
        </div>
        <h1 class="home-name">LOCKN</h1>
        <% if (user) { %>
            <div class="flex-container">
                <div class="home-card">
                    <h2>fitness</h2>
                    <a href="/plan"></a>
                </div>

                <div class="home-card">
                    <h2>tasks</h2>
                    <p>rank: <span><%= userTaskRank %></span></p>
                    <a href="/tasks"></a>
                </div>

                <div class="home-card">
                    <h2>goals</h2>
                    <p>rank: <span><%= userGoalRank  %></span></p>
                    <a href="/goals"></a>
                </div>
            </div>
        <% } %>
        <!-- <div class="path-flex">
            <div class="leaderboard-path">
                <a href="/groups"><h2>GROUPS<span class="arrow">&#x2192</span></h2></a>
            </div>
            <div class="leaderboard-path">
                <a href="/leaderboard"><h2>LEADERBOARD<span class="arrow">&#x2192</span></h2></a>
            </div>
        </div> -->
    </body>
</html>