<!DOCTYPE html>
<html lang="en">
    <head>
        <meta charset="UTF-8">
        <meta name="viewport" content="width=device-width, initial-scale=1.0">
        <link rel="stylesheet" href="styles/style1.css" type="text/css">
    </head>

    <body>
        <div class="mainHeader">
            <img class="logo" src="../../assests/images/lockNWhite-01.png">
            <br>
            <% if (user) { %>
                <a href="/logout" class="login">Logout</a>
            <% } else { %>
                <a href="/login" class="login">Login</a>
            <% } %>
        </div>
        <div class="flex-container">
            <div class="home-card">
                <h2>Fitness</h2>
                <div class="home-rank">
                </div>
                <a href="/plan"></a>
            </div>

            <div class="home-card">
                <h2>Tasks</h2>
                <% if (user) { %>
                    <p>Rank: <span class="home-num"><%= userTaskRank %></span></p>
                    <p>Remaining Tasks: <span class="home-num">14</span></p>
                    <p>Tasks Completed: <span class="home-num">124</span></p>
                    <a href="/tasks"><button><span class="home-btn-text">Tasks </span><span class="btn-arrow">&#x2192</span></button></a>
                <% } %>
                <a href="/tasks"></a>
            </div>

            <div class="home-card">
                <h2>Goals</h2>
                <% if (user) { %>
                    <div class="home-rank">
                        <p>Rank</p>
                        <%= userGoalRank %>
                    </div>
                <% } %>
                <a href="/goals"></a>
            </div>
        </div>
        <div class="path-flex">
            <div class="leaderboard-path">
                <a href="/groups"><h2>GROUPS<span class="arrow">&#x2192</span></h2></a>
            </div>
            <div class="leaderboard-path">
                <a href="/leaderboard"><h2>LEADERBOARD<span class="arrow">&#x2192</span></h2></a>
            </div>
        </div>
    </body>
</html>